<?xml version="1.0" ?>

<sdf version="1.8">
  <model name="custom_yolo_drone">
    
    <include>
      <name>x3_frame</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV</uri>
    </include>

    <link name="yolo_camera_link">
      <pose>0.1 0 0.05 0 0 0</pose> <sensor name="yolo_camera" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera</topic>
      </sensor>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent>x3_frame</parent>
      <child>yolo_camera_link</child>
    </joint>

   <!-- The Missing Engine: Velocity Control Plugin -->
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>cmd_vel</topic>
    </plugin>

  </model>
</sdf>

